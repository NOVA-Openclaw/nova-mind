{
  "id": "agent_config_sync",
  "main": "./dist/index.js",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "database": {
        "type": "string",
        "description": "PostgreSQL database name"
      },
      "host": {
        "type": "string",
        "description": "PostgreSQL host"
      },
      "port": {
        "type": "integer",
        "description": "PostgreSQL port"
      },
      "user": {
        "type": "string",
        "description": "PostgreSQL user"
      },
      "password": {
        "type": "string",
        "description": "PostgreSQL password"
      },
      "outputPath": {
        "type": "string",
        "description": "Path to write agents.json (default: ~/.openclaw/agents.json)"
      },
      "openclawConfigPath": {
        "type": "string",
        "description": "Path to openclaw.json for adding the explicit-ownership root include (default: ~/.openclaw/openclaw.json)"
      },
      "explicitConfigPath": {
        "type": "string",
        "description": "Path to write the 11.3+ explicit-ownership include file (default: ~/.openclaw/agents-explicit.json)"
      }
    }
  }
}
