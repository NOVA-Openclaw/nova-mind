{
  "name": "@nova/memory-extract",
  "version": "1.0.0-726",
  "description": "Memory extraction plugin: extracts entities, facts, opinions, and relationships from incoming messages and stores them in PostgreSQL",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
