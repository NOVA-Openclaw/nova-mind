# Peer-only pgschema ignore file (nova-mind#608 / #1231).
#
# On federation peers some objects declared as TABLEs by schema.sql exist as
# VIEWs or FOREIGN TABLEs (e.g. agent_bootstrap_context as a VIEW, ai_models as
# a FOREIGN TABLE).  The installer now detects these dynamically before planning
# by querying the target DB for public relations with relkind IN ('f','v')
# whose names match a table that schema.sql CREATEs (#1231).  Detected names are
# injected into [tables]/[views] at plan time and stripped from the post-plan
# filter by database/strip_destructive.py --ignore-objects.
#
# This static file is therefore kept ONLY for objects and patterns that cannot
# be derived from that query: functions, triggers, and the nova_bootstrap_context
# foreign table (which is not declared by schema.sql but is part of the peer
# FDW bootstrap stack).
#
# Keep this file in sync with database/.pgschemaignore (the base ignore set).

[tables]
patterns = [
  # Base patterns from database/.pgschemaignore
  "portfolios",
  "portfolio_snapshots",
  "portfolio_asset_classes",
  "positions",
  "trades",
  "cash_ledger",
  "strategies",
  "strategy_notes",
  "instruments",
  "asset_classes",
  "open_orders",
  "order_adjustments",
  "price_cache_v2",
  "*_local",
  # Peer-only FDW bootstrap-context stack (#608 / #1231)
  # agent_bootstrap_context is injected dynamically when the target has it as a VIEW.
  "nova_bootstrap_context"     # foreign table imported from nova_memory (not in schema.sql)
]

[views]
patterns = [
  # agent_bootstrap_context is injected dynamically when the target has it as a VIEW.
]

[functions]
patterns = [
  "bootstrap_context_view_*",  # peer INSTEAD OF trigger functions (where present)
  "protect_bootstrap_context_writes_v2"
]

[triggers]
patterns = [
  "protect_bootstrap_context",
  "heartbeat_content_changed",
  "zz_touch_updated_at"
]
