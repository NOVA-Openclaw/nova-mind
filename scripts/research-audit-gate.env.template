# research-audit-gate.py runtime configuration template.
#
# Copy to the environment that runs the gate (e.g. workflow-32 step 3) and
# adjust values. All keys are optional; defaults are shown in comments.
#
# PostgreSQL connection parameters are resolved through memory/lib/pg_env.py,
# which reads PG* environment variables and ~/.openclaw/postgres.json. This
# file contains gate-specific tunables only.

# Schema containing research_findings, research_citations, and research_tasks.
# Default: public
RESEARCH_AUDIT_GATE_SCHEMA=public

# Hours within which an unreachable source is retried; elapsed >= this value
# causes the citation to be dropped and the finding re-evaluated on remaining
# citations. Default: 72
RESEARCH_AUDIT_GATE_DROP_WINDOW_HOURS=72

# Jev Support Noul probability at or below which a claim/citation pair
# escalates to skeptics. Calibrated value from research/se1282/v3: 0.05.
# Default: 0.05
RESEARCH_AUDIT_GATE_SUPPORT_THRESHOLD=0.05

# Direct TypeSafe /v1/systemone endpoint. Do not route through jev-router.
# Default: https://api.typesafe.ai/v1/systemone
RESEARCH_AUDIT_GATE_JEV_URL=https://api.typesafe.ai/v1/systemone

# API key for the TypeSafe endpoint. Keep this secret.
RESEARCH_AUDIT_GATE_JEV_API_KEY=
