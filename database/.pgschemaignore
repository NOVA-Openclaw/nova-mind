# Objects to exclude from pgschema management
# See https://www.pgschema.com/cli/ignore
#
# NOTE (nova-mind#498): the installer is now additive-by-construction. It
# strips every DROP operation from the pgschema plan before applying, so
# unknown/local tables are preserved automatically without relying on this
# ignore list. This file remains as a secondary/legacy guard to reduce plan
# noise and protect objects that should never be managed declaratively.
#
# schema.sql is a dump of nova_memory. Peer agents (victoria, newhart,
# graybeard) carry agent-local tables in their own <agent>_memory databases
# that nova_memory does not have.
#
# Agent-local tables are not managed by the shared schema. Previously a
# hard-coded list of Victoria trading tables lived here; it was removed in
# nova-mind#792 because strip_destructive.py strips every DROP operation,
# making the static list redundant.
#
# Generic pattern: any table suffixed _local is agent-local by convention
# and never managed by the shared schema.

[tables]
patterns = [
  "*_local"
]
