[Unit]
Description=NOVA Agent Spawner Daemon
Documentation=https://github.com/NOVA-Openclaw/nova-cognition/issues/68
After=network.target postgresql.service openclaw-gateway.service
Wants=postgresql.service

[Service]
Type=simple
User=nova
Group=nova
WorkingDirectory=/home/nova/workspace
# %u expands to the service manager's user (root) in system units, not User=.
# Do NOT use %u in Environment= lines. Instead, resolve the agent DB at exec
# time under User=nova via lib/pg-env.sh.
Environment=NOVA_DB_HOST=localhost
Environment=OPENCLAW_GATEWAY=http://localhost:18789
EnvironmentFile=-/home/nova/.config/openclaw/env

# The deployed pg-env.sh is the one the installer writes. The currently
# deployed copy is from Feb and lacks resolve_agent_db until the installer
# runs, so the ExecStart wrapper below fails closed if NOVA_DB is unresolved.
ExecStart=/bin/bash -c 'PG_ENV="/home/nova/.openclaw/lib/pg-env.sh"; if [ -f "$PG_ENV" ]; then source "$PG_ENV" || { echo "agent-spawner: failed to source $PG_ENV" >&2; exit 1; }; load_pg_env 2>/dev/null || true; fi; NOVA_DB="${NOVA_DB:-$(resolve_agent_db)}"; if [ -z "$NOVA_DB" ]; then echo "agent-spawner: NOVA_DB unresolved (pg-env.sh missing or stale; resolve_agent_db may be absent until installer runs)" >&2; exit 1; fi; export NOVA_DB NOVA_DB_USER="${NOVA_DB_USER:-$(whoami)}"; exec /home/nova/workspace/scripts/agent-spawner.py'
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-spawner

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nova/workspace /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
